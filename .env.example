# Copy to .env.local and fill in. Never commit the real file.
#
# Local development: run `supabase start`, then copy the "API URL" and
# "anon key" it prints.
#
# Production: Supabase dashboard -> Project Settings -> API. Use the ANON key.
# The service_role key must never be placed in any VITE_ variable: everything
# prefixed VITE_ is bundled into the app and visible to anyone who installs it.

VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
